{
  // ─────────────────────────────────────────────────────────────
  // VSCode 调试配置示例（Flutter/Dart 扩展）。
  //
  // 使用方式：
  //   1. 复制本文件为同目录下的 launch.json（launch.json 已被
  //      .gitignore 忽略，个人改动不会污染仓库）；
  //   2. 按 F5 或运行面板选择对应环境即可。
  //
  // 环境方案（A+B 混合）：
  //   baseUrl 等配置经 --dart-define-from-file 在编译期注入，
  //   见 env/ 目录与 lib/core/config/app_config.dart。
  //   不带 toolArgs 直接运行时安全回落 dev + 演示 API。
  //
  // FVM 说明：
  //   Dart 扩展（v3.98+）自动读取 .fvmrc 锁定的 Flutter 版本，
  //   无需在 IDE 中额外指定 SDK 路径。
  // ─────────────────────────────────────────────────────────────
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev (debug)",
      "cwd": "${workspaceFolder}",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=env/dev.json"
      ]
    },
    {
      "name": "staging (debug)",
      "cwd": "${workspaceFolder}",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=env/staging.json"
      ]
    },
    {
      "name": "prod (debug)",
      "cwd": "${workspaceFolder}",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=env/prod.json"
      ]
    },
    {
      "name": "prod (profile)",
      "cwd": "${workspaceFolder}",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // profile 模式：接近 release 性能，保留 DevTools 时间线。
      "flutterMode": "profile",
      "toolArgs": [
        "--dart-define-from-file=env/prod.json"
      ]
    }
  ]
}
